{
  "id": "qa",
  "name": "QA",
  "version": "0.1.0",
  "entry": "index.html",
  "description": "App-agnostic software testing: mix native GUI, Web DOM, HTTP API and CLI steps in a guided case editor, then watch every action and its evidence.",
  "contributes": [
    {
      "slot": "nav",
      "title": "QA",
      "icon": "generic"
    }
  ],
  "backend": {
    "command": "bin/qa-backend"
  },
  "methods": [
    "app.info",
    "qa.targets",
    "qa.probe",
    "qa.capture",
    "qa.ax",
    "qa.act",
    "qa.inspect",
    "qa.project.list",
    "qa.project.open",
    "qa.project.save",
    "qa.cases.read",
    "qa.cases.write",
    "qa.baseline.get",
    "qa.baseline.put",
    "qa.run.record",
    "qa.run.list",
    "qa.pi.status",
    "qa.pi.check",
    "qa.pi.update",
    "qa.pi.ask",
    "qa.cases.draft"
  ],
  "requires": {
    "ai": 1
  }
}
